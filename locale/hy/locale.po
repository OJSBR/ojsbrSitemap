#, fuzzy
msgid "plugins.generic.ojsbrSitemap.displayName"
msgstr "Բարելավված կայքի քարտեզ"

#, fuzzy
msgid "plugins.generic.ojsbrSitemap.description"
msgstr "Բարելավում է ամսագրի կայքի քարտեզը որոնողական համակարգերի համար։ Հեռացնում է մուտքի, գրանցման, որոնման և ընթացիկ համարի էջերը և նախնական տարբերակները, ավելացնում է յուրաքանչյուր էջի փոփոխման ամսաթիվը, խմբագրական կազմը, գաղտնիության հայտարարությունը, կատեգորիաները և յուրաքանչյուր էջի հղումները ամսագրի մյուս լեզուներով (hreflang)։"

#, fuzzy
msgid "plugins.generic.ojsbrSitemap.task"
msgstr "Ստեղծել ամսագրերի կայքի քարտեզները"
