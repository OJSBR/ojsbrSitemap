msgid "plugins.generic.ojsbrSitemap.displayName"
msgstr "Sitemap migliorata"

msgid "plugins.generic.ojsbrSitemap.description"
msgstr "Migliora la sitemap della rivista per i motori di ricerca. Toglie le pagine di accesso, registrazione, ricerca e fascicolo corrente e le gabbie, e aggiunge la data di modifica di ogni pagina, il comitato di redazione, l'informativa sulla privacy, le categorie e i collegamenti a ogni pagina nelle altre lingue della rivista (hreflang)."

msgid "plugins.generic.ojsbrSitemap.task"
msgstr "Generare le sitemap delle riviste"
