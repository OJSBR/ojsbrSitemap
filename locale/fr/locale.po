msgid "plugins.generic.ojsbrSitemap.displayName"
msgstr "Sitemap amélioré"

msgid "plugins.generic.ojsbrSitemap.description"
msgstr "Améliore le sitemap de la revue pour les moteurs de recherche. Il retire les pages de connexion, d'inscription, de recherche et du numéro courant ainsi que les documents à publier, et ajoute la date de modification de chaque page, le comité éditorial, l'énoncé de confidentialité, les catégories et les liens vers chaque page dans les autres langues de la revue (hreflang)."

msgid "plugins.generic.ojsbrSitemap.task"
msgstr "Générer les sitemaps des revues"
